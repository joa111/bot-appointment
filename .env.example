# =========================================================================
# AppointmentBot Pro Environment Template
# Duplicate this file as '.env' and fill in your Supabase project values
# =========================================================================

# 1. Frontend Keys (exposed to Vite)
# Settings > API > Project URL
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Settings > API > Connection info > anon (public) key
VITE_SUPABASE_ANON_KEY=your-supabase-publishable-anon-key

# 2. Supabase Edge Functions Secrets (Set these in your Supabase dashboard or via CLI)
# Settings > API > Connection info > service_role (secret) key
# (Deno Edge functions retrieve this automatically, but you might need it for local testing)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# API key from your Resend Dashboard (https://resend.com) for sending notification emails
RESEND_API_KEY=re_your_resend_api_key
